# Static SPA image: builds apps/web with Vite, serves the output with nginx.
# There is no server-side rendering and no /api proxying here — in k8s the
# `/api` route belongs to oauth2-proxy (architecture §11), not to nginx.
#
# Build from the repo root:  docker build -f docker/Dockerfile.web .

FROM node:22-slim AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/chess-analysis/package.json packages/chess-analysis/
COPY apps/web/package.json apps/web/
RUN npm ci \
    --workspace=@chess-coach/shared \
    --workspace=@chess-coach/chess-analysis \
    --workspace=@chess-coach/web \
    --include-workspace-root

COPY packages/shared packages/shared
COPY packages/chess-analysis packages/chess-analysis
COPY apps/web apps/web
# `tsc -b && vite build` — the typecheck is part of the build script.
RUN npm run build --workspace=@chess-coach/web

# --- runtime: nothing but the bundle and nginx ------------------------------
# nginx-unprivileged listens on 8080 as a non-root user, which is what the
# chart's runAsNonRoot pod securityContext requires (§12).
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

EXPOSE 8080
