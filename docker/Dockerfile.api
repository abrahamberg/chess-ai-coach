# Runtime image for `api`, `worker` and the Helm migrate-job — one image, three
# commands (dist-bundle/{server,worker,migrate}.mjs).
#
# COPY-only by design: nothing is compiled or installed here. The bundle and the
# production node_modules are built on the CI runner first, which is faster and
# better-cached than doing the same work inside a Docker layer. See
# docs/deploy-build.md for the exact commands that must run before this build.
#
# Why this matters for arm64: `tsx` (the runtime TS loader this image used to
# need) depends on esbuild, whose native binary — @esbuild/linux-x64 vs
# @esbuild/linux-arm64 — is selected at npm-install time by the *build* machine's
# architecture. Copying an amd64 runner's node_modules into an arm64 container
# would ship the wrong binary. apps/api is therefore bundled ahead of time and
# runs on plain `node`, and every remaining production dependency is pure
# JavaScript — no native binaries, no install scripts, no os/cpu constraints
# (audited; see docs/deploy-build.md) — so the copied tree is portable.
FROM node:22-slim AS runtime
LABEL org.opencontainers.image.source="https://github.com/abrahamberg/chess-ai-coach"
WORKDIR /app
ENV NODE_ENV=production

# Pre-built on the runner by:
#   npm ci --omit=dev --workspace=@chess-coach/api --include-workspace-root
# First-party workspace code is inlined into the bundle, so the dangling
# @chess-coach/* symlinks this tree contains are never resolved at runtime.
COPY node_modules ./node_modules

# Pre-built on the runner by `npm run bundle --workspace=@chess-coach/api`.
# Self-contained ESM (`.mjs`), so no package.json is needed alongside it.
COPY apps/api/dist-bundle ./dist-bundle

# Numeric, not `USER node`. Kubelet enforces the chart's `runAsNonRoot: true` by
# reading the image's user, and it cannot resolve a *name* to a uid inside the
# image: a named user makes every pod fail admission with "image has non-numeric
# user (node), cannot verify user is non-root". 1000 is exactly the `node` user's
# uid in node:22-slim, and it matches podSecurityContext.runAsUser in
# deploy/helm/chess-ai-coach/values.yaml. Everything COPY'd above is owned by
# root but world-readable, so uid 1000 can read node_modules and dist-bundle.
USER 1000
ENV PORT=3000
EXPOSE 3000
# The worker Deployment and the migrate-job override this with worker.mjs and
# migrate.mjs respectively (same image, different command).
CMD ["node", "dist-bundle/server.mjs"]
