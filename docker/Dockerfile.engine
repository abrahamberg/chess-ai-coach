FROM node:22-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends stockfish \
    && rm -rf /var/lib/apt/lists/*
ENV STOCKFISH_PATH=/usr/games/stockfish

WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/shared/package.json packages/shared/
COPY services/engine/package.json services/engine/
RUN npm ci --workspace=@chess-coach/shared --workspace=@chess-coach/engine

COPY packages/shared packages/shared
COPY services/engine services/engine
RUN npm run typecheck -- --build services/engine

ENV PORT=8081
EXPOSE 8081
CMD ["node", "--experimental-strip-types", "services/engine/src/server.ts"]
