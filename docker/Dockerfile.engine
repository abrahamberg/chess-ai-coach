FROM node:22-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends stockfish \
    && rm -rf /var/lib/apt/lists/*
ENV STOCKFISH_PATH=/usr/games/stockfish

WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/shared/package.json packages/shared/
COPY services/engine/package.json services/engine/
RUN npm ci --workspace=@chess-coach/shared --workspace=@chess-coach/engine --include-workspace-root

COPY packages/shared packages/shared
COPY services/engine services/engine
RUN npm run typecheck -- --build services/engine

# Run as the base image's `node` user, by *number*. The Helm chart applies
# `runAsNonRoot: true` to every pod, and kubelet resolves that against the image:
# an image with no USER runs as root and the pod is rejected outright
# ("container has runAsNonRoot and image will run as root"), while a *named* user
# is rejected as unverifiable. 1000 is `node` in node:22-slim and matches
# podSecurityContext.runAsUser in deploy/helm/chess-ai-coach/values.yaml.
# /usr/games/stockfish (0755 root:root) and everything npm installed into /app
# stay readable/executable for it; tsx only ever writes to /tmp.
USER 1000

ENV PORT=8081
EXPOSE 8081
# tsx, not plain node --experimental-strip-types: workspace packages' exports
# point at raw .ts source (e.g. @chess-coach/shared -> src/index.ts), whose
# own NodeNext-style `./foo.js` relative imports (really `./foo.ts`) plain
# Node's type-stripping does not resolve. `npm run typecheck` above is the
# build-time type-safety gate; this is just the runtime loader.
CMD ["npx", "tsx", "services/engine/src/server.ts"]
