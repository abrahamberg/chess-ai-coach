FROM node:22-slim
LABEL org.opencontainers.image.source="https://github.com/abrahamberg/chess-ai-coach"

RUN apt-get update \
    && apt-get install -y --no-install-recommends stockfish \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV STOCKFISH_PATH=/usr/games/stockfish

# The bundle is created by scripts/build-images.sh on the runner. Keeping
# compilation and npm installation outside Docker makes this image portable
# across amd64 and arm64 builds.
COPY services/engine/dist-bundle ./dist-bundle

USER 1000
ENV PORT=8081
EXPOSE 8081
CMD ["node", "dist-bundle/server.mjs"]
