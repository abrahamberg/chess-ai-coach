FROM node:22-slim
LABEL org.opencontainers.image.source="https://github.com/abrahamberg/chess-ai-coach"

RUN apt-get update \
    && apt-get install -y --no-install-recommends stockfish \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV STOCKFISH_PATH=/usr/games/stockfish

# Install only runtime dependencies inside the target-architecture build. This
# ensures optional/native packages, if added later, resolve for amd64 or arm64
# instead of copying a host-architecture node_modules tree.
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/chess-analysis/package.json packages/chess-analysis/
COPY services/engine/package.json services/engine/
RUN npm ci --omit=dev --no-audit --no-fund \
    --workspace=@chess-coach/shared \
    --workspace=@chess-coach/chess-analysis \
    --workspace=@chess-coach/engine \
    --include-workspace-root

# The application bundle is created by scripts/build-images.sh on the runner.
COPY services/engine/dist-bundle ./dist-bundle

USER 1000
ENV PORT=8081
EXPOSE 8081
CMD ["node", "dist-bundle/server.mjs"]
