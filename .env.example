# Copy to .env and fill in real values to use `docker compose --profile auth up`
# (the real oauth2-proxy path). Not needed for everyday dev — AUTH_MODE=dev-stub
# (the default) skips all of this. See docs/dev-setup.md.

OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=

# Optional: use real LLM providers instead of LLM_FAKE=1.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_STANDARD_MODEL_ANTHROPIC=claude-sonnet-4-5
# LLM_STANDARD_MODEL_OPENAI=gpt-5.5
# LLM_LIGHT_MODEL_ANTHROPIC=claude-haiku-4-5
# LLM_LIGHT_MODEL_OPENAI=gpt-5.4-mini

# Optional: how each tier is called. Reasoning effort is portable — the same
# value works on both Anthropic and OpenAI. Defaults reason on the coach and
# not on the mechanical light-tier subagents.
# LLM_REASONING_STANDARD=medium   # provider-default|none|minimal|low|medium|high|xhigh
# LLM_REASONING_LIGHT=none

# Optional: OpenAI's service tier. `flex` is roughly half price but slower and
# can be refused under load, so it is off (`auto`) unless set here. Anthropic
# has no equivalent and ignores this.
# LLM_OPENAI_SERVICE_TIER=auto    # auto|default|flex|priority

# Optional: guards against a provider that opens a stream and then stalls,
# which would otherwise hold a session's turn lock indefinitely.
# LLM_STREAM_FIRST_CHUNK_TIMEOUT_MS=120000
# LLM_STREAM_CHUNK_TIMEOUT_MS=60000

# Optional (Task 5): daily LRU-style cache-pruning job for position_evaluations
# (apps/api/src/jobs/prune-position-evaluations.ts, run via graphile-worker's
# crontab at 3 AM UTC). MAX_ROWS is the table's row cap; MIN_AGE_DAYS protects
# rows created more recently than this from eviction even when over cap. See
# db/repositories/position-evaluations.ts's pruneOverCap.
# POSITION_EVAL_CACHE_MAX_ROWS=200000
# POSITION_EVAL_CACHE_MIN_AGE_DAYS=3

# Optional (Task 8.1): credit packs via Stripe Checkout. Leave unset to run
# without Stripe — /api/credits/checkout and /api/stripe/webhook simply don't
# register. Once STRIPE_SECRET_KEY is set the rest are required together.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_SMALL=
# STRIPE_PRICE_MEDIUM=
# STRIPE_PRICE_LARGE=
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/settings?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/settings?checkout=cancel

# Optional: shared secret between the api and worker processes for the
# engine-tunnel internal relay (design spec 2026-08-08, plan header notes).
# Change this in any real deployment — the default is dev-only.
# ENGINE_TUNNEL_INTERNAL_TOKEN=dev-internal-token
