# Keep the build context small. Deliberately does NOT exclude node_modules or
# apps/*/dist — docker/Dockerfile.api copies the pre-built production
# node_modules and docker/Dockerfile.web copies apps/web/dist (see
# docs/deploy-build.md).
.git
.gitignore
.github
.claude
.superpowers
coverage
docs
deploy
*.tsbuildinfo

# Workspace build/test inputs that no runtime Dockerfile needs. Keep the
# pre-built API/web artifacts and the engine's source workspace packages.
apps/*/src
apps/*/test
apps/*/node_modules
packages/*/test
services/*/test
services/*/node_modules
packages/prompts
